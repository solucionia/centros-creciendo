# ─── Dependencies & build ──────────────────────────────────────────────────
node_modules
dist
server/public
*.tar.gz

# ─── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
vite.config.ts.*

# ─── Secrets & environment (NEVER commit) ───────────────────────────────────
# Real environment files. env.example (placeholders only) is intentionally NOT
# ignored so the template stays in the repo.
.env
.env.*
*.env
!env.example

# Private keys, certificates and credential files
*.pem
*.key
*.pfx
*.p12
*.keystore
id_rsa*
secrets/
*secret*.json
*credentials*.json

# ─── SQLite session store (runtime data — never commit) ─────────────────────
data/
sessions.db
sessions.db-shm
sessions.db-wal

# ─── Replit local state (may contain agent tokens / logs) ────────────────────
.local/
.cache/
.upm/
.config/
