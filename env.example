# Copy this file to .env (or set these as environment variables / Replit secrets).

# ─── WhatsApp OTP login (GoHighLevel / LeadConnector) ─────────────────────────
# Private integration API key with read/write on Contacts.
CRM_API_KEY=
# Location ID of the clinic in the CRM.
CRM_LOCATION_ID=
# LeadConnector API base URL (default below is correct for most setups).
CRM_BASE_URL=https://services.leadconnectorhq.com
# OTP time-to-live in seconds.
OTP_EXPIRY_SECONDS=300
# Max failed verification attempts before the code is invalidated.
OTP_MAX_ATTEMPTS=3

# ─── Session ──────────────────────────────────────────────────────────────────
# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=
# Express "trust proxy" setting. Leave unset (= false) for local / no-proxy.
# Set to 1 (hop count) when behind a single reverse proxy (Replit, nginx, etc.).
# Accepts: a number, "true", "false", or a CIDR/named preset string.
TRUST_PROXY=

# ─── DriCloud (existing integration) ──────────────────────────────────────────
DRICLOUD_URL_CLINICA=
DRICLOUD_CLINICA_ID=
DRICLOUD_API_PASSWORD=
